# Copy to .env and fill in. Server-only: never use a PUBLIC_ prefix.
# Netlify: set the same names under Site configuration → Environment variables.

# Contentful → Settings → General settings → Space ID
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master

# Contentful → Settings → API keys → Add API key (name it wishlist-2627)
# → "Content Delivery API - access token". Used by the site to read items.
CONTENTFUL_DELIVERY_TOKEN=

# Contentful → Settings → CMA tokens → Create personal access token.
# Used by the claim endpoint and scripts. Scripts fall back to your
# `contentful login` token if this is empty.
CONTENTFUL_MANAGEMENT_TOKEN=
