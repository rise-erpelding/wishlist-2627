---
import type { PublicItem } from '../lib/wishlist';
import { CATEGORY_COLOR } from '../lib/colors';

interface Props {
  item: PublicItem;
}
const { item } = Astro.props;
const color = CATEGORY_COLOR[item.category];
const state = item.claimed ? 'claimed' : 'open';
const host = item.url ? new URL(item.url).hostname.replace(/^www\./, '') : null;
---

<li class="card" data-item data-state={state} data-category={item.category}>
  <div class="media" style={`--ph-bg: ${color.bg}; --ph-fg: ${color.fg}`}>
    <span class="placeholder display" aria-hidden="true">{item.title.slice(0, 1)}</span>
    {
      item.image && (
        <img
          src={item.image.src}
          srcset={item.image.srcset || undefined}
          sizes="(min-width: 1100px) 340px, (min-width: 700px) 45vw, 92vw"
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy={item.image.hosted ? undefined : 'no-referrer'}
          onerror="this.remove()"
        />
      )
    }
    {item.claimed && <span class="stamp">Claimed</span>}
  </div>
  <div class="body">
    <p class="label" style={`--dot: ${color.bg}`}>{item.categoryLabel}</p>
    <h3>
      {
        item.url ? (
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            {item.title}
            <span class="visually-hidden">(opens {host} in a new tab)</span>
          </a>
        ) : (
          item.title
        )
      }
    </h3>
    {item.description && <p class="desc">{item.description}</p>}
    <div class="actions">
      {
        item.claimed ? (
          <p class="status">Someone is giving this</p>
        ) : (
          <button type="button" class="pill primary" data-claim={item.id} data-title={item.title}>
            I'll give this
          </button>
        )
      }
      {item.multi && item.claimCount > 0 && (
        <p class="status">
          {item.claimCount} {item.claimCount === 1 ? 'person is' : 'people are'} giving one
        </p>
      )}
    </div>
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 2px solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-2);
  }
  .card[hidden] {
    display: none;
  }
  .media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-media);
    overflow: hidden;
    /* Product photos are shot on white; img keeps a white backing in both themes.
       The placeholder underneath shows if there is no image or it fails to load. */
  }
  img {
    position: absolute;
    inset: 0;
    background: #fff;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-3);
    box-sizing: border-box;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--ph-bg);
    color: var(--ph-fg);
    font-size: 120px;
  }
  .stamp {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    font-weight: 600;
    font-size: 14px;
  }
  .card[data-state='claimed'] img {
    filter: grayscale(1);
  }
  /* Dim with an overlay, not opacity, so the placeholder never shows through. */
  .card[data-state='claimed'] .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0.55;
  }
  .stamp {
    z-index: 1;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3) var(--space-1) var(--space-1);
  }
  .label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .label::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
  }
  h3 {
    font-size: 19px;
    line-height: 1.25;
    margin: var(--space-1) 0;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  h3 a:hover {
    color: var(--link);
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .actions {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .status {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
  }
</style>
