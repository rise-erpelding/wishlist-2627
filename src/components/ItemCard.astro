---
import type { PublicItem } from '../lib/wishlist';
import { CATEGORY_COLOR } from '../lib/colors';

interface Props {
  item: PublicItem;
  /** Recipient slug, so forms can send people back to this page. */
  slug: string;
}
const { item, slug } = Astro.props;
const color = CATEGORY_COLOR[item.category];
const state = item.claimed ? 'claimed' : 'open';
const host = item.url ? new URL(item.url).hostname.replace(/^www\./, '') : null;
---

<li class="card" id={`item-${item.id}`} data-item data-item-id={item.id} data-multi={item.multi ? '' : undefined} data-state={state} data-category={item.category}>
  <div class="media" style={`--ph-bg: ${color.bg}; --ph-fg: ${color.fg}`}>
    <span class="placeholder display" aria-hidden="true">{item.title.slice(0, 1)}</span>
    {
      item.image && (
        <img
          src={item.image.src}
          srcset={item.image.srcset || undefined}
          sizes="(min-width: 1100px) 340px, (min-width: 700px) 45vw, 92vw"
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy={item.image.hosted ? undefined : 'no-referrer'}
          onerror="this.remove()"
        />
      )
    }
    <span class="stamp" data-stamp hidden={!item.claimed}>Claimed</span>
  </div>
  <div class="body">
    <p class="label" style={`--dot: ${color.bg}`}>{item.categoryLabel}</p>
    <h3>
      {
        item.url ? (
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            {item.title}
            <span class="visually-hidden">(opens {host} in a new tab)</span>
          </a>
        ) : (
          item.title
        )
      }
    </h3>
    {item.description && <p class="desc">{item.description}</p>}
    <div class="actions" data-actions>
      {
        item.claimed ? (
          <>
            <p class="status">Someone is giving this</p>
            <form method="post" action="/api/unclaim" data-unclaim>
              <input type="hidden" name="itemId" value={item.id} />
              <input type="hidden" name="returnTo" value={slug} />
              <button type="submit" class="text-button">
                Unclaim<span class="visually-hidden"> {item.title}</span>
              </button>
            </form>
          </>
        ) : (
          // A link so it still works without JavaScript; the script opens the dialog instead.
          <a class="pill primary" href={`/${slug}?claim=${item.id}#claim-dialog`} data-claim={item.id} data-title={item.title}>
            I'll give this<span class="visually-hidden">: {item.title}</span>
          </a>
        )
      }
      <!-- Shown by the script right after this person claims it. -->
      <p class="status" data-giving hidden>You're giving this</p>
      <p class="status" data-multi-count hidden={!(item.multi && item.claimCount > 0)}>
        {item.claimCount} {item.claimCount === 1 ? 'person is' : 'people are'} giving one
      </p>
    </div>
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 2px solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-2);
  }
  .card[hidden] {
    display: none;
  }
  .media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-media);
    overflow: hidden;
    /* Product photos are shot on white; img keeps a white backing in both themes.
       The placeholder underneath shows if there is no image or it fails to load. */
  }
  img {
    position: absolute;
    inset: 0;
    background: #fff;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-3);
    box-sizing: border-box;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--ph-bg);
    color: var(--ph-fg);
    font-size: 120px;
  }
  .stamp {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    font-weight: 600;
    font-size: 14px;
  }
  .card[data-state='claimed'] img {
    filter: grayscale(1);
  }
  /* Dim with an overlay, not opacity, so the placeholder never shows through. */
  .card[data-state='claimed'] .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    opacity: 0.55;
  }
  .stamp {
    z-index: 1;
  }
  .stamp[hidden] {
    display: none;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3) var(--space-1) var(--space-1);
  }
  .label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .label::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
  }
  h3 {
    font-size: 19px;
    line-height: 1.25;
    margin: var(--space-1) 0;
    overflow-wrap: anywhere;
  }
  h3 a {
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  h3 a:hover {
    color: var(--link);
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .actions {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .status[hidden] {
    display: none;
  }
  .text-button {
    min-height: var(--target);
    padding: 0 var(--space-1);
    border: 0;
    background: none;
    color: var(--link);
    font: 600 15px var(--font-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .status {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
  }
</style>
