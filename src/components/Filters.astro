---
interface Props {
  categories: { key: string; label: string; count: number }[];
}
const { categories } = Astro.props;
---

<!-- Hidden until the script runs: without JS every item simply shows. -->
<div class="filters" data-filters hidden>
  <div class="group" role="group" aria-label="Show">
    <button type="button" class="pill" data-status="all" aria-pressed="true">All</button>
    <button type="button" class="pill" data-status="open" aria-pressed="false">Still open</button>
    <button type="button" class="pill" data-status="claimed" aria-pressed="false">Claimed</button>
  </div>
  {
    categories.length > 1 && (
      <div class="group" role="group" aria-label="Category">
        {categories.map((c) => (
          <button type="button" class="pill chip" data-category={c.key} aria-pressed="false">
            {c.label} <span class="count">{c.count}</span>
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-filters]')) {
    root.hidden = false;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    let status = 'all';
    const cats = new Set<string>();

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okStatus = status === 'all' || card.dataset.state === status;
        const okCat = cats.size === 0 || cats.has(card.dataset.category ?? '');
        card.hidden = !(okStatus && okCat);
        if (!card.hidden) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button');
      if (!button) return;
      if (button.dataset.status) {
        status = button.dataset.status;
        for (const b of root.querySelectorAll<HTMLButtonElement>('[data-status]')) {
          b.setAttribute('aria-pressed', String(b === button));
        }
      } else if (button.dataset.category) {
        const key = button.dataset.category;
        const on = !cats.has(key);
        if (on) cats.add(key);
        else cats.delete(key);
        button.setAttribute('aria-pressed', String(on));
      }
      apply();
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0;
  }
  .filters[hidden] {
    display: none;
  }
  .group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .pill[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .count {
    opacity: 0.6;
    font-weight: 500;
  }
</style>
